{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "custom/pistons/piston_base"
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "custom/pistons/piston_base",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "custom/pistons/piston_base",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "custom/pistons/piston_base",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "custom/pistons/piston_base",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "custom/pistons/piston_base",
        "x": 90
      }
    },
    {
      "when": {
        "extended": false,
        "facing": "north"
      },
      "apply": {
        "model": "custom/pistons/piston_head_sticky"
      }
    },
    {
      "when": {
        "extended": false,
        "facing": "south"
      },
      "apply": {
        "model": "custom/pistons/piston_head_sticky",
        "y": 180
      }
    },
    {
      "when": {
        "extended": false,
        "facing": "east"
      },
      "apply": {
        "model": "custom/pistons/piston_head_sticky",
        "y": 90
      }
    },
    {
      "when": {
        "extended": false,
        "facing": "west"
      },
      "apply": {
        "model": "custom/pistons/piston_head_sticky",
        "y": 270
      }
    },
    {
      "when": {
        "extended": false,
        "facing": "up"
      },
      "apply": {
        "model": "custom/pistons/piston_head_sticky",
        "x": 270
      }
    },
    {
      "when": {
        "extended": false,
        "facing": "down"
      },
      "apply": {
        "model": "custom/pistons/piston_head_sticky",
        "x": 90
      }
    }
  ]
}