{
  "model": {
    "type": "minecraft:condition",
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/bow"
          }
        }
      ],
      "scale": 1,
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:custom/tools/bow/bow"
      }
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui"],
          "model": {
            "type": "minecraft:range_dispatch",
            "entries": [
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/bow_pulling_1"
                },
                "threshold": 0.65
              },
              {
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/bow_pulling_2"
                },
                "threshold": 0.9
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_0"
            },
            "property": "minecraft:use_duration",
            "scale": 0.05
          }
        }
      ],
      "scale": 1,
      "fallback": {
        "type": "minecraft:range_dispatch",
        "entries": [
          {
            "model": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:custom/tools/bow/bow_pulling_1"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:custom/tools/bow/arrow_pulling_1"
                }
              ]
            },
            "threshold": 0.65
          },
          {
            "model": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:custom/tools/bow/bow_pulling_2"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:custom/tools/bow/arrow_pulling_2"
                }
              ]
            },
            "threshold": 0.9
          }
        ],
        "fallback": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:custom/tools/bow/bow_pulling_0"
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:custom/tools/bow/arrow_pulling_0"
            }
          ]
        },
        "property": "minecraft:use_duration",
        "scale": 0.05
      }
    },
    "property": "minecraft:using_item"
  }
}